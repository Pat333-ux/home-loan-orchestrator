{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nwo-dao.org/schemas/borrower-profile.json",
  "title": "BorrowerProfile",
  "type": "object",
  "required": [
    "borrowerId",
    "firstName",
    "lastName",
    "ssnLast4",
    "email",
    "phone",
    "walletAddress",
    "firstTimeBuyer",
    "creditScore",
    "annualHouseholdIncome",
    "monthlyDebtPayments",
    "county",
    "state",
    "purchasePrice",
    "loanAmount",
    "isPrimaryResidence",
    "attachmentType",
    "constructionMethod"
  ],
  "properties": {
    "borrowerId": { "type": "string" },
    "firstName": { "type": "string" },
    "lastName": { "type": "string" },
    "ssnLast4": { "type": "string", "pattern": "^[0-9]{4}$" },
    "email": { "type": "string", "format": "email" },
    "phone": { "type": "string" },
    "walletAddress": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
    "firstTimeBuyer": { "type": "boolean" },
    "creditScore": { "type": "integer", "minimum": 300, "maximum": 850 },
    "annualHouseholdIncome": { "type": "number", "minimum": 0 },
    "monthlyDebtPayments": { "type": "number", "minimum": 0 },
    "county": { "type": "string" },
    "state": { "type": "string", "const": "IN" },
    "purchasePrice": { "type": "number", "minimum": 10000 },
    "loanAmount": { "type": "number", "minimum": 10000 },
    "isPrimaryResidence": { "type": "boolean" },
    "attachmentType": { "type": "string", "enum": ["Attached", "Detached"] },
    "constructionMethod": { "type": "string", "enum": ["SiteBuilt", "Manufactured"] }
  }
}
